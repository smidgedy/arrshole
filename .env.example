# qBittorrent (required)
QBIT_URL=http://localhost:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=

# Sonarr (optional — at least one *arr must be configured)
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# Radarr (optional)
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# Lidarr (optional)
LIDARR_URL=http://localhost:8686
LIDARR_API_KEY=

# Category mapping (optional — defaults to exact name match: "sonarr", "radarr", "lidarr")
# Format: comma-separated category:app pairs for custom category names
# CATEGORY_MAP=tv-sonarr:sonarr,movies:radarr,music:lidarr

# Behavior
POLL_INTERVAL_SECONDS=60
METADATA_STUCK_MINUTES=10
# Stalled thresholds: maxPercent:hours pairs. Torrents at or below maxPercent% progress
# will be cleared after the specified hours stalled. Last entry must cover 100%.
# Default "100:24" = flat 24h for all. Example tiered: "10:1,90:12,100:24"
STALLED_THRESHOLDS=10:1,90:12,100:24
MAX_ACTIONS_PER_CYCLE=5
# Outage guard: skip ALL actions for a cycle when qBittorrent's global download
# rate is at/below OUTAGE_SPEED_FLOOR_BYTES while at least OUTAGE_MIN_ACTIVE
# torrents are trying to download. Prevents a client-wide outage (everything
# stalls at 0 B/s at once) from being mistaken for a batch of dead releases and
# mass-blocklisted. Auto-resumes once speed recovers. Set OUTAGE_GUARD=false to
# disable. Fail-safe: if the rate can't be read, the cycle is skipped.
OUTAGE_GUARD=true
OUTAGE_SPEED_FLOOR_BYTES=1024
OUTAGE_MIN_ACTIVE=3
# Import-rejection reaper (opt-in, default off): scan *arr queues for releases
# that finished downloading but were rejected at import (e.g. Lidarr rejecting an
# album for a missing track), and clean up the orphaned download. Driven entirely
# by *arr queue status (trackedDownloadState + statusMessages), never qBit state.
# Defective releases (incomplete/wrong) are blocklisted and re-searched; redundant
# ones (already have an equal/better file — "not an upgrade") are cleaned up and
# blocklisted but NOT re-searched. Set to true to enable.
IMPORT_REJECT=false
DRY_RUN=true
# Log level: debug, info, warn, error, fatal
LOG_LEVEL=info
# Path to persist tracking state across restarts
STATE_FILE=./arrshole-state.json
